# Copy to .env and fill in. NEVER commit the real .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Model used for the agent loop and summarisation.
GEMINI_MODEL=gemini-2.0-flash

# Embedding model. text-embedding-004 was retired by Google and now 404s.
# The index dimension is detected from the first response, so swapping models
# needs no code change - only a cleared data/index.
EMBED_MODEL=gemini-embedding-001

# gemini-embedding-001 defaults to 3072 dims; it is Matryoshka-trained, so 768
# keeps almost all retrieval quality at a quarter of the memory. Vectors at any
# dimension other than 3072 come back unnormalised, and the store normalises them.
EMBED_DIM=768

# Max agent steps before the loop is force-stopped and a partial answer returned.
MAX_STEPS=6

# Port. Hugging Face Spaces expects 7860.
PORT=7860
