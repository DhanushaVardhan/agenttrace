# Copy to .env and fill in. NEVER commit the real .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Model used for the agent loop and summarisation.
GEMINI_MODEL=gemini-2.0-flash

# Embedding model. The index dimension is detected from the first response,
# so you can swap this for gemini-embedding-001 without touching the code.
EMBED_MODEL=text-embedding-004

# Max agent steps before the loop is force-stopped and a partial answer returned.
MAX_STEPS=6

# Port. Hugging Face Spaces expects 7860.
PORT=7860
